{
  "permissions": {
    "allow": [
      "Edit(/apps/**)",
      "Edit(/packages/**)",
      "Edit(/prisma/**)",
      "Edit(/e2e/**)",
      "Edit(/docs/**)",
      "Bash(git commit *)",
      "Bash(git switch release/*)",
      "Bash(yarn dev*)",
      "Bash(yarn e2e*)",
      "Bash(yarn db:*)",
      "Bash(yarn prisma generate*)",
      "Bash(yarn prisma migrate dev*)",
      "Bash(yarn prisma migrate status*)",
      "Bash(yarn prisma db seed*)",
      "Bash(docker compose up*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose stop*)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(npx vitest run *)",
      "Bash(npx vitest related *)",
      "Bash(curl -s -o /dev/null -w * http://localhost:*)",
      "Bash(npx playwright test *)",
      "Bash(yarn test:e2e*)",
      "Bash(cd *)",
      "Bash(sed -n *)",
      "Bash(printf * >> docs/run/journal.md)",
      "Bash(node scripts/measure.mjs *)",
      "Bash(node scripts/tokens-from-css.mjs *)",
      "Bash(node scripts/tokens-lint.mjs *)",
      "Bash(node docs/_team/templates/scripts/extract-provided.mjs *)"
