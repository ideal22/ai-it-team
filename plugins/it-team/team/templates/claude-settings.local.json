    "deny": [
      "Bash(sed -i*)",
      "Bash(sed -n -i*)",
      "Bash(sed * -i *)",
      "Bash(find / *)",
      "Bash(find ~*)",
      "Bash(find $HOME*)",
      "Bash(yarn prisma migrate reset*)",
      "Bash(yarn prisma migrate deploy*)",
      "Bash(yarn prisma db push*)",
      "Bash(docker compose down -v*)"
    ]
  }
}
